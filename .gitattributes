# Default: let Git handle line endings using the user's core.autocrlf
# setting, but be explicit for files where it matters.

# Shell scripts must always be LF (executed on Linux/macOS).
*.sh         text eol=lf
*.bash       text eol=lf

# Dockerfiles run inside Linux containers.
Dockerfile*  text eol=lf

# Makefile is consumed by GNU make on Linux/macOS.
Makefile     text eol=lf

# YAML / TOML / JSON / Markdown — keep LF for cross-platform consistency.
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# Python source files — LF.
*.py         text eol=lf

# Pre-commit hook files.
.pre-commit-config.yaml  text eol=lf

# Windows shell scripts must be CRLF.
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Mark binary so Git does not try to diff or merge.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.svg        text
*.pdf        binary
*.zip        binary
*.tar        binary
*.tar.gz     binary
*.parquet    binary
*.xlsx       binary
*.docx       binary

