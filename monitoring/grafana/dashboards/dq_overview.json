{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.3.1" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "DataQuality.AI platform overview — backend operation counters and latency.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(data_source_create_count_total[5m])",
          "legendFormat": "create {{result}}",
          "refId": "A"
        },
        {
          "expr": "rate(data_source_update_count_total[5m])",
          "legendFormat": "update {{result}}",
          "refId": "B"
        },
        {
          "expr": "rate(data_source_archive_count_total[5m])",
          "legendFormat": "archive {{result}}",
          "refId": "C"
        },
        {
          "expr": "rate(data_source_test_connection_count_total[5m])",
          "legendFormat": "test_conn {{result}}",
          "refId": "D"
        }
      ],
      "title": "Data Source Operations (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(dataset_create_count_total[5m])",
          "legendFormat": "create {{result}}",
          "refId": "A"
        },
        {
          "expr": "rate(dataset_update_count_total[5m])",
          "legendFormat": "update {{result}}",
          "refId": "B"
        },
        {
          "expr": "rate(dataset_activate_count_total[5m])",
          "legendFormat": "activate {{result}}",
          "refId": "C"
        },
        {
          "expr": "rate(dataset_archive_count_total[5m])",
          "legendFormat": "archive {{result}}",
          "refId": "D"
        }
      ],
      "title": "Dataset Operations (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(permission_audit_query_duration_ms_bucket[5m]))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(permission_audit_query_duration_ms_bucket[5m]))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(permission_audit_query_duration_ms_bucket[5m]))",
          "legendFormat": "p99 {{endpoint}}",
          "refId": "C"
        }
      ],
      "title": "Permission Audit Query Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(permission_audit_list_requests_total[5m])",
          "legendFormat": "list {{result}}",
          "refId": "A"
        },
        {
          "expr": "rate(permission_audit_export_requests_total[5m])",
          "legendFormat": "export {{result}}",
          "refId": "B"
        }
      ],
      "title": "Permission Audit Requests (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short",
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "up{job=\"dq-backend\"}",
          "legendFormat": "Backend",
          "refId": "A"
        }
      ],
      "title": "Backend Health",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dataquality", "backend", "observability"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DataQuality.AI — Platform Overview",
  "uid": "dq-platform-overview",
  "version": 1
}
