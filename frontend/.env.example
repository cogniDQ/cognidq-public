# Frontend (Vite) configuration. Copy to frontend/.env and adjust.
#
# Vite reads these at BUILD time. After changing, rebuild the frontend
# (or restart `npm run dev` for local development).
#
# Variables must be prefixed with VITE_ to be exposed to the browser.
# Anything in this file ends up in the public bundle — never put a
# secret here.

# ---------------------------------------------------------------------
# Where the API lives.
#
# Local dev with the bundled Vite proxy: leave empty (the proxy in
# vite.config.ts forwards /api to http://backend:8000).
#
# Production / staging: set to the public URL of the backend, e.g.
#   VITE_API_URL=https://api.cognidq.example.com/api/v1
#
# Local dev with Docker Compose: use /api/v1 (relative path) so requests
# go through the Vite dev proxy. Do NOT use http://localhost:8000/api/v1 —
# that bypasses the proxy and causes CORS errors inside the container.
# ---------------------------------------------------------------------
VITE_API_URL=/api/v1

# ---------------------------------------------------------------------
# UI branding.
# ---------------------------------------------------------------------
VITE_APP_NAME=CogniDQ
VITE_APP_TAGLINE=Open data quality control plane

# ---------------------------------------------------------------------
# Optional dev tooling. Off by default.
# ---------------------------------------------------------------------
# Mount React Query / React Router devtools in dev builds.
VITE_ENABLE_DEV_TOOLS=false

# Verbose console logging for the API client.
VITE_VERBOSE_API_LOGS=false

# ---------------------------------------------------------------------
# Feature flag mirrors. The backend is the source of truth; these
# control whether the UI even renders the relevant entry point. Keep
# in sync with backend/.env.
# ---------------------------------------------------------------------
VITE_ENABLE_COMPLEX_FLOW_BUILDER=false
VITE_ENABLE_OPENMETADATA_INTEGRATION=false
VITE_ENABLE_KQI=false
