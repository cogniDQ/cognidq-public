# Root .env — read by Docker Compose at YAML parse time for variable interpolation.
#
# HOW TO USE:
#   cp .env.example .env
#   Edit .env and fill in every required value below.
#
# This file is SEPARATE from backend/.env (which is injected into the backend
# container at runtime).  Both files must have matching values for the shared
# keys (OPENAI_API_KEY, *_ENCRYPTION_KEY, MINIO_*, GF_*).
#
# NEVER commit .env to version control.  It is listed in .gitignore.

# =====================================================================
# REQUIRED — docker compose up will fail if these are empty or missing.
# =====================================================================

# OpenAI API key.  Set a real key to enable the NL rule builder.
# Leave the placeholder to run without LLM features; set
# ENABLE_COMPLEX_FLOW_BUILDER=false in backend/.env to suppress errors.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Fernet keys for encrypting stored data-source credentials.
# Generate each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use TWO DIFFERENT keys.
DATASOURCE_ENCRYPTION_KEY=replace-with-fernet-key-generated-locally
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key-generated-locally

# MinIO object storage.  Any non-default password.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password

# Grafana admin password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password

# Flower basic auth (Celery monitor UI at :5555).  Format user:password.
FLOWER_BASIC_AUTH=admin:change-me-strong-password

# =====================================================================
# RECOMMENDED — use secure random values in any non-laptop environment.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# =====================================================================

SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# =====================================================================
# OPTIONAL — override defaults if needed.
# =====================================================================

# Frontend URL used in invitation / activation emails.
APP_PUBLIC_URL=http://localhost:5173
